# Copia questo file come ".env" e compila le chiavi.

# --- Modello usato da tutti gli agenti ---------------------------------
# OpenAI (chiave fornita da Reply all'evento):   LLM_MODEL=openai/<modello>  + OPENAI_API_KEY
# Gemini (gratis con chiave da https://aistudio.google.com/apikey):
LLM_MODEL=gemini/gemini-3.5-flash

# Modelli di riserva, provati in ordine se il principale e' occupato (503/429).
# Quelli senza chiave nel .env vengono saltati.
LLM_MODELLI_RISERVA=gemini/gemini-3.7-flash,gemini/gemini-3.1-flash-lite,gemini/gemini-3.8-flash,groq/llama-3.3-70b-versatile

OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Simulazione --------------------------------------------------------
# true = nessuna chiamata API: riproduce l'ultimo risultato vero o la demo
MOCK_MODE=true

# --- Limiti -------------------------------------------------------------
RAGIONAMENTO=low          # low = veloce, high = piu' accurato ma lento
TIMEOUT_SECONDI=90        # attesa massima per risposta, poi passa alla riserva
MAX_ESERCIZI=0            # 0 = tutti; 2 = test rapido sui primi 2 esercizi
MAX_RPM=10
MAX_ITER=3
TEMPERATURA=0.4
VERBOSE=false

# --- Niente telemetria verso i server di CrewAI (non serve account) ----
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
CREWAI_DISABLE_VERSION_CHECK=true
